# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── JWT (REQUIRED — use a long random string, never commit the real value) ───
JWT_SECRET=change_me_to_a_long_random_string

# ─── Database (REQUIRED) ──────────────────────────────────────────────────────
# Render: copied automatically when you link a Render PostgreSQL database.
# Local dev: postgresql://postgres:<password>@localhost:5432/renthub
DATABASE_URL=postgresql://user:password@host:5432/renthub

# ─── Frontend URL for CORS (REQUIRED in production) ──────────────────────────
# Set to your deployed Vercel URL — no trailing slash
FRONTEND_URL=https://your-app.vercel.app

# ─── Backend public URL ───────────────────────────────────────────────────────
BASE_URL=https://your-backend.onrender.com

# ─── File uploads directory ───────────────────────────────────────────────────
# NOTE: Render's free tier has an ephemeral filesystem.
# Uploads will NOT persist across deploys unless you use Cloudinary (see below).
UPLOADS_DIR=./uploads

# ─── Email / Nodemailer ───────────────────────────────────────────────────────
# Use Gmail with an App Password (not your main password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Rent Hub <your_email@gmail.com>

# ─── Cloudinary (optional — for persistent image uploads) ────────────────────
# Get free credentials at: https://cloudinary.com
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── M-Pesa Daraja (optional) ─────────────────────────────────────────────────
# MPESA_CONSUMER_KEY=your_consumer_key
# MPESA_CONSUMER_SECRET=your_consumer_secret
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# MPESA_CALLBACK_URL=https://your-backend.onrender.com/api/payments/mpesa/callback
# MPESA_ENV=sandbox

# ─── Admin setup (one-time use) ───────────────────────────────────────────────
# POST /api/setup/promote-admin  { "secret": "<this value>", "email": "user@example.com" }
ADMIN_SETUP_SECRET=change_me_to_a_strong_random_string
